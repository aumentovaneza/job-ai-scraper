# Shared environment for the Docker stack (app, queue, scheduler).
# These values override the in-image .env because Docker-set variables take
# precedence over the dotenv file. Change APP_KEY before any real deployment.
APP_NAME="Job AI Scraper"
APP_ENV=local
APP_KEY=base64:h+Ho4PUZubZ8hndcx3YldnR34cAfH72bZWMPYTDTzXY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database (PostgreSQL + pgvector service)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# Redis service
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Drive cache / sessions / queue through Redis
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

MAIL_MAILER=log
